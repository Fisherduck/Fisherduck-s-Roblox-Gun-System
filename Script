local RS = game:GetService("ReplicatedStorage")

local GunModules = RS:WaitForChild("Gun Modules")
local RaycastingModule = require(GunModules:WaitForChild("RaycastingModule"))
local AmmoModule = require(GunModules:WaitForChild("AmmoModule"))
local ShootingModule = require(GunModules:WaitForChild("ShootingModule"))

local RaycastingEvent = RS:WaitForChild("RaycastingEvent")
local ReloadEvent = RS:WaitForChild("ReloadEvent")

local RunService = game:GetService("RunService")

----------------------------------------

local PlayerShooters = {}


RaycastingEvent.OnServerEvent:Connect(function(player, inputPosition)
	if not player then return end

	local character = player.Character
	if not character then return end

	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then return end

	local handle = tool:FindFirstChild("Handle")
	if not handle then return end
	
	local origin = handle.Position
	local direction = (inputPosition - origin).Unit

	if not PlayerShooters[player] then
		PlayerShooters[player] = ShootingModule.new("Pistol", character)
	end
	
	local shooting = PlayerShooters[player]
	shooting:Fire(origin, direction)
end)


ReloadEvent.OnServerEvent:Connect(function(player)
	if not player then return end

	local character = player.Character
	if not character then return end

	local tool = character:FindFirstChildOfClass("Tool")
	if not tool then return end
	
	local shooting = PlayerShooters[player]
	shooting:Reload()
end)
